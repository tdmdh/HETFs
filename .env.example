# IBKR Credentials needed if falling back to Docker compose initialization
TWS_USERID=YOUR_USERNAME_HERE
TWS_PASSWORD=YOUR_PASSWORD_HERE

# Set TRADING_MODE to 'live' or 'paper'
TRADING_MODE=paper

# Browser session cookie for IBKR Client Portal Gateway authentication.
# After logging in at https://127.0.0.1:5000, open DevTools (F12) → Application →
# Cookies → https://127.0.0.1, copy the x-sess-uuid value and paste below.
SESSION_COOKIE=x-sess-uuid=

